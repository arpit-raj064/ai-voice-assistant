# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]

# ── Virtual environment ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment variables — NEVER commit this ─────────────────────────────
.env
.env.local
.env.production

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
frontend/build/
frontend/.next/
.npm

# ── Audio files (generated by tts.py during calls) ───────────────────────
static/audio/*.mp3
static/audio/*.wav

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── VS Code ───────────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── Database / sensitive exports ─────────────────────────────────────────
*.sqlite
*.db
